{
  "schema_version": "harness-module/v0",
  "module_id": "distribution",
  "kind": "capability",
  "description": "Bootstrap, installation, update, uninstall, and isolated distribution verification.",
  "default_activation": true,
  "dependencies": {
    "kernel_api": "v1",
    "modules": ["thin-trust-kernel"]
  },
  "requested_capabilities": ["filesystem-read", "filesystem-write", "process-execution"],
  "ownership": {
    "owned_paths": [
      "modules/distribution/**",
      "harness.cmd",
      "harness.ps1",
      "install.ps1",
      "schemas/distribution-plan.schema.json",
      "schemas/install-profile.schema.json",
      "scripts/generate-skills-index.ps1",
      "scripts/get-distribution-plan.ps1",
      "scripts/install-transaction-common.ps1",
      "scripts/lib/Harness.Distribution.psm1",
      "scripts/run-isolated-install-smoke.ps1",
      "scripts/update-managed-assets.ps1",
      "tests/fixture-test-common.ps1",
      "uninstall.ps1"
    ],
    "watch_paths": [
      "scripts/lib/Harness.AtomicWrite.psm1",
      "scripts/lib/Harness.Hashing.psm1",
      "scripts/lib/Harness.Path.psm1"
    ]
  },
  "entrypoints": {
    "commands": ["harness.ps1", "install.ps1", "uninstall.ps1", "scripts/update-managed-assets.ps1", "scripts/get-distribution-plan.ps1"],
    "hooks": []
  },
  "validation": {
    "owner_tests": [
      "tests/verify-declarative-distribution.ps1",
      "tests/verify-v2-install-presets.ps1",
      "tests/verify-preset-lifecycle-qualification.ps1",
      "tests/verify-v2-evidence.ps1"
    ],
    "quick": [],
    "core_group": "install-evidence",
    "changed": [],
    "full": [
      "tests/verify-declarative-distribution.ps1",
      "tests/verify-v2-install-presets.ps1",
      "tests/verify-preset-lifecycle-qualification.ps1",
      "tests/verify-v2-evidence.ps1"
    ]
  }
}
