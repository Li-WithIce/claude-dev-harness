      "tests/verify-host-benchmark-otel.ps1",
      "tests/verify-host-benchmark-qualification.ps1",
      "tests/verify-release-runner-boundary.ps1",
      "tests/verify-release-isolation-qualification.ps1",
      "tests/verify-release-full-receipt.ps1",
