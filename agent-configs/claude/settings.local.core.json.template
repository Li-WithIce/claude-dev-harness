{
  "PreToolUse": [
    {
      "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "pwsh -NoProfile -NonInteractive -File \"{CLAUDE_HOME}\\hooks-memory\\pretooluse.ps1\"",
          "timeout": 15
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{CLAUDE_HOME}\\hooks-memory\\stop.js\"",
          "timeout": 10
        }
      ]
    }
  ]
}
