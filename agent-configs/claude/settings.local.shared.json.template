{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{CLAUDE_HOME}\\hooks-memory\\userpromptsubmit.js\"",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{CLAUDE_HOME}\\hooks-memory\\stop.js\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{CLAUDE_HOME}\\hooks-memory\\posttooluse.js\"",
          "timeout": 10
        }
      ]
    }
  ],
  "permissions": {
    "allow": []
  }
}
