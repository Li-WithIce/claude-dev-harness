# Managed by install.ps1
# Host-managed config stays workspace-agnostic.
# Active workspace is derived per invocation from explicit args, env, or cwd.
# Only Harness-managed skills/path metadata belong in this block.
# Keep user-owned [[skills.config]] entries outside this block.

[managed.shared_paths]
skills_root = "{CODEX_HOME}\\skills"

# `entry-router` is the default development-task entry skill. The core
# stage skills stay available for harness dispatch; lazy loading is governed
# by AGENTS routing and `plan.md` frontmatter.
[[skills.config]]
path = "{CODEX_HOME}\\skills\\entry-router\\SKILL.md"
enabled = true

[[skills.config]]
path = "{CODEX_HOME}\\skills\\orchestrator\\SKILL.md"
enabled = true

[[skills.config]]
path = "{CODEX_HOME}\\skills\\plan\\SKILL.md"
enabled = true

[[skills.config]]
path = "{CODEX_HOME}\\skills\\implement\\SKILL.md"
enabled = true

[[skills.config]]
path = "{CODEX_HOME}\\skills\\review\\SKILL.md"
enabled = true

[[skills.config]]
path = "{CODEX_HOME}\\skills\\test\\SKILL.md"
enabled = true
