# Managed by install.ps1
# Host-managed config stays workspace-agnostic.
# Active workspace is derived per invocation from explicit args, env, or cwd.
# Only Harness-managed skills/path metadata belong in this block.
# Keep user-owned [[skills.config]] entries outside this block.

[managed.shared_paths]
skills_root = "{CODEX_HOME}\\skills"

[[skills.config]]
path = "{CODEX_HOME}\\skills\\entry-router\\SKILL.md"
enabled = false

# Legacy explicit compatibility path for the using-superpowers alias; not part of harness-lite defaults.
[[skills.config]]
path = "{CODEX_HOME}\\skills\\using-superpowers\\SKILL.md"
enabled = false

[[skills.config]]
path = "{CODEX_HOME}\\skills\\orchestrator\\SKILL.md"
enabled = false

[[skills.config]]
path = "{CODEX_HOME}\\skills\\plan\\SKILL.md"
enabled = false

[[skills.config]]
