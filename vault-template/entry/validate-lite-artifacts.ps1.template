# Project-local lite artifact validator shim.
# Delegates to the harness repo validator without requiring a workspace scripts directory.
[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string]$TaskId
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

<#
.SYNOPSIS
Validate lite task artifacts from the workspace.
.DESCRIPTION
This shim exposes the managed validator under `.assistant\entry` so project users do not need to know the harness repo path.
.PARAMETER TaskId
The task id under `docs/tasks/<task-id>/`.
.OUTPUTS
None.
#>

& '{REPO_ROOT}\scripts\validate-lite-artifacts.ps1' -TaskId $TaskId -RepoRoot '{REPO_ROOT}'
exit $LASTEXITCODE
