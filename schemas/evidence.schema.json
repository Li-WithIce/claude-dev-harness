{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/evidence.schema.json",
  "title": "Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_version", "contract_digest", "revision", "records", "coverage", "conclusion"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["evidence/v1"] },
    "task_id": { "type": "string", "pattern": "^(?!(?:none|idle|unknown)$)[a-z0-9][a-z0-9-]{0,63}$" },
    "task_version": { "type": "integer", "minimum": 1 },
    "contract_digest": { "$ref": "#/definitions/sha256" },
    "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{7,40}|dirty:[0-9a-f]{64})$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/record" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satisfied", "not_verified", "blocked"],
      "properties": {
        "satisfied": { "$ref": "#/definitions/stringArray" },
        "not_verified": { "$ref": "#/definitions/stringArray" },
        "blocked": { "$ref": "#/definitions/stringArray" }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["not-verified", "blocked", "unavailable", "manual"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conclusion": { "type": "string", "enum": ["pass", "fail", "blocked", "partial"] }
  },
  "allOf": [
    {
      "if": { "properties": { "conclusion": { "enum": ["pass"] } } },
      "then": {
        "properties": {
          "gaps": { "maxItems": 0 },
          "coverage": {
            "properties": {
              "not_verified": { "maxItems": 0 },
              "blocked": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "model"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "context_id": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "oneOf": [
        { "$ref": "#/definitions/commandRecord" },
        { "$ref": "#/definitions/inspectionRecord" }
      ]
    },
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "cwd", "exit_code", "executed_at", "evidence_path", "digest", "covers"],
      "properties": {
        "type": { "type": "string", "enum": ["command"] },
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "$ref": "#/definitions/relativePath" },
        "exit_code": { "type": "integer" },
        "executed_at": { "type": "string", "format": "date-time" },
        "evidence_path": { "$ref": "#/definitions/relativePath" },
        "digest": { "$ref": "#/definitions/sha256" },
        "covers": { "$ref": "#/definitions/stringArray" },
        "actor": { "$ref": "#/definitions/actor" }
      }
    },
    "inspectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "method", "result", "executed_at", "evidence_path", "digest", "covers"],
      "properties": {
        "type": { "type": "string", "enum": ["inspection"] },
        "method": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "enum": ["pass", "fail", "blocked", "partial"] },
        "executed_at": { "type": "string", "format": "date-time" },
        "evidence_path": { "$ref": "#/definitions/relativePath" },
        "digest": { "$ref": "#/definitions/sha256" },
        "covers": { "$ref": "#/definitions/stringArray" },
        "actor": { "$ref": "#/definitions/actor" }
      }
    }
  }
}
