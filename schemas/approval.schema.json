{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/approval.schema.json",
  "title": "Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "task_version",
    "contract_digest",
    "approval_type",
    "approved_scope",
    "approver",
    "approved_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["approval/v1"] },
    "approval_id": { "type": "string", "pattern": "^apr_[A-Za-z0-9._-]+$" },
    "task_id": { "type": "string", "pattern": "^(?!(?:none|idle|unknown)$)[a-z0-9][a-z0-9-]{0,63}$" },
    "task_version": { "type": "integer", "minimum": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "protected_operation": { "$ref": "#/definitions/protectedOperation" },
    "approval_type": { "type": "string", "enum": ["product", "architecture", "production"] },
    "approved_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approver": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "approved_at": { "type": "string", "format": "date-time" },
    "expires_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "status": { "type": "string", "enum": ["granted", "revoked", "expired", "invalidated"] }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "protectedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "environment", "action_category", "targets", "approval_type", "approval_scope", "identity"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["protected-operation/v1"] },
        "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "action_category": { "type": "string", "enum": ["protected-write"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "approval_type": { "type": "string", "enum": ["none", "product", "architecture", "production"] },
        "approval_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:rule:[a-z0-9][a-z0-9-]{0,63}|command_digest:sha256:[0-9a-f]{64}|environment:[a-z0-9][a-z0-9._-]{0,63}|path:.+|dry-run:true)$"
          }
        },
        "identity": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
