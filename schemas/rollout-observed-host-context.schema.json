{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/rollout-observed-host-context.schema.json",
  "title": "Thin Harness observed Host context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "cli_version",
    "service_version",
    "hook_contract",
    "invocation_telemetry_contract",
    "request_send_contract",
    "observed_at_utc",
    "context_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["rollout-observed-host-context/v1"] },
    "product": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "cli_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "service_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "hook_contract": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "invocation_telemetry_contract": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "request_send_contract": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
