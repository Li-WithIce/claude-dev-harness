{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/requirement-contract.schema.json",
  "title": "Requirement Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "acceptance",
    "in_scope",
    "product_constraints",
    "product_decisions",
    "unresolved_product_decisions",
    "source_authority",
    "digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["requirement-contract/v1"] },
    "task_id": { "$ref": "#/definitions/taskId" },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance": { "$ref": "#/definitions/nonEmptyStringArray" },
    "in_scope": { "$ref": "#/definitions/nonEmptyStringArray" },
    "out_of_scope": { "$ref": "#/definitions/stringArray" },
    "product_constraints": { "$ref": "#/definitions/stringArray" },
    "product_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "source"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number", "integer", "boolean", "null"] },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved_product_decisions": { "$ref": "#/definitions/stringArray" },
    "source_authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "enum": [
          "current-user-message",
          "user-confirmed",
          "approved-spec",
          "project-policy",
          "project-product-decision"
        ]
      },
      "items": {
        "type": "string",
        "enum": [
          "current-user-message",
          "user-confirmed",
          "approved-spec",
          "project-policy",
          "project-product-decision",
          "project-architecture-decision",
          "repo-evidence",
          "engineering-convention"
        ]
      }
    },
    "digest": { "$ref": "#/definitions/sha256" }
  },
  "definitions": {
    "taskId": { "type": "string", "pattern": "^(?!(?:none|idle|unknown)$)[a-z0-9][a-z0-9-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
