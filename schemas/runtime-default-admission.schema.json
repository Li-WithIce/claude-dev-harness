{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/runtime-default-admission.schema.json",
  "title": "TK-03 Runtime admission for historical Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "new_task_protocol",
    "scope",
    "source_revision",
    "source_identity",
    "decision_id",
    "issued_at_utc",
    "required_capabilities",
    "decision_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["harness-runtime-default/v1"] },
    "new_task_protocol": { "type": "string", "enum": ["v2"] },
    "scope": { "type": "string", "enum": ["workspace-canary", "release-default"] },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "tree_oid",
        "path_set_digest",
        "runtime_contract_digest"
      ],
      "properties": {
        "schema_version": { "type": "string", "enum": ["harness-runtime-source-identity/v1"] },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "tree_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "path_set_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "runtime_contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "decision_id": { "type": "string", "pattern": "^rtd_[0-9a-f]{32}$" },
    "issued_at_utc": { "type": "string", "minLength": 1 },
    "expires_at_utc": { "type": ["string", "null"], "minLength": 1 },
    "workspace_identity_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "workspace_protocol_config",
          "structured_tool_events",
          "request_send_telemetry",
          "desktop_profile_isolation",
          "hook_status_query"
        ]
      }
    },
    "decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
