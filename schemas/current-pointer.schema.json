{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/current-pointer.schema.json",
  "title": "Current Task Pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_version", "activated_at"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["current-pointer/v1"] },
    "task_id": {
      "type": "string",
      "pattern": "^(?!(?:none|idle|unknown)$)[a-z0-9][a-z0-9-]{0,63}$"
    },
    "task_version": { "type": "integer", "minimum": 1 },
    "activated_at": { "type": "string", "format": "date-time" }
  }
}
