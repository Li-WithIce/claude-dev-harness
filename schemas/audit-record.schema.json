{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/audit-record.schema.json",
  "title": "Independent Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementer_actor_id",
    "reviewer_actor_id",
    "reviewer_context_id",
    "reviewer_base_model",
    "independence_level",
    "evidence_digest"
  ],
  "properties": {
    "implementer_actor_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "reviewer_actor_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "reviewer_context_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "reviewer_base_model": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "independence_level": {
      "type": "string",
      "enum": ["isolated-context", "different-actor"]
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
