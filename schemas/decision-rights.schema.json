{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_rank", "categories", "default_unknown_owner", "agent_decision_constraints"],
  "properties": {
    "schema_version": { "const": "decision-rights/v1" },
    "default_unknown_owner": { "const": "product" },
    "authority_rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current-user-message", "user-confirmed", "approved-spec", "project-policy", "project-product-decision", "project-architecture-decision", "repo-evidence", "engineering-convention"],
      "properties": {
        "current-user-message": { "const": 0 },
        "user-confirmed": { "const": 0 },
        "approved-spec": { "const": 1 },
        "project-policy": { "const": 2 },
        "project-product-decision": { "const": 2 },
        "project-architecture-decision": { "const": 3 },
        "repo-evidence": { "const": 4 },
        "engineering-convention": { "const": 5 }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "architecture", "agent"],
      "properties": {
        "product": { "$ref": "#/definitions/nonEmptyStrings" },
        "architecture": { "$ref": "#/definitions/nonEmptyStrings" },
        "agent": { "$ref": "#/definitions/nonEmptyStrings" }
      }
    },
    "agent_decision_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_be_reversible", "must_not_change_external_behavior", "must_follow_repo_conventions", "must_be_verified"],
      "properties": {
        "must_be_reversible": { "const": true },
        "must_not_change_external_behavior": { "const": true },
        "must_follow_repo_conventions": { "const": true },
        "must_be_verified": { "const": true }
      }
    }
  },
  "definitions": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  }
}
