{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-harness.local/schemas/protocol-config-v2.schema.json",
  "title": "Harness v2-only workspace admission config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "new_task_protocol", "new_work"],
  "properties": {
    "schema_version": { "const": "harness-protocol-config/v2" },
    "new_task_protocol": { "enum": ["auto", "v2"] },
    "new_work": { "enum": ["enabled", "paused"] }
  }
}
