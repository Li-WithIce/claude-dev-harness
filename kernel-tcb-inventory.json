{
  "schema_version": "kernel-tcb/v1",
  "generator_contract_version": "kernel-tcb-generator/v1",
  "roots": [
    {
      "id": "workspace-bootstrap",
      "path": "harness.ps1",
      "trust_path": "distribution",
      "role": "Bootstrap and reconcile installed Workspace assets, then project status.",
      "layer": "d1-distribution",
      "reason": "The Distribution Trust Path is inventoried separately so the complete installer never becomes a K1 dependency or Runtime budget input."
    },
    {
      "id": "codex-pretooluse-launcher",
      "path": "runtime-hooks/claude/codex-pretooluse-launcher.ps1",
      "trust_path": "runtime",
      "role": "Bridge Codex Hook transport to the installed PreToolUse adapter.",
      "layer": "a3-adapter",
      "reason": "The launcher fails closed and is part of the installed Codex protected-write path."
    },
    {
      "id": "claude-pretooluse-adapter",
      "path": "runtime-hooks/claude/pretooluse.ps1",
      "trust_path": "runtime",
      "role": "Deserialize Claude/Codex tool input and call K1 preflight_action.",
      "layer": "a3-adapter",
      "reason": "Host mutation transport remains selected while patch, path, and Policy authority move into Harness.AdapterAction."
    },
    {
      "id": "entry-contract-compiler",
      "path": "scripts/generate-entry-contract.ps1",
      "trust_path": "runtime",
      "role": "Compile and verify the canonical Entry Contract bootstrap.",
      "layer": "k1-runtime-kernel",
      "reason": "Entry Contract is an irreducible Harness trust responsibility."
    },
    {
      "id": "status-cli",
      "path": "scripts/harness-status.ps1",
      "trust_path": "runtime",
      "role": "Read-only Runtime, protocol, host-capability, and protected-policy status projection.",
      "layer": "k1-runtime-kernel",
      "reason": "Status is a separate read-only root and must not be inferred from task creation."
    },
    {
      "id": "controlled-write-adapter",
      "path": "scripts/harness-write-mcp.ps1",
      "trust_path": "runtime",
      "role": "MCP host adapter for Kernel-controlled file writes.",
      "layer": "a3-adapter",
      "reason": "Covers the ordinary controlled-write entry independent of Hook activation."
    },
    {
      "id": "risk-policy-evaluator",
      "path": "scripts/lib/Harness.Policy.psm1",
      "trust_path": "runtime",
      "role": "Resolve risk routing and execution-profile requirements.",
      "layer": "k1-runtime-kernel",
      "reason": "Risk Routing is an irreducible Harness trust responsibility even though host prose performs the first inline classification hop."
    },
    {
      "id": "task-cli",
      "path": "scripts/task.ps1",
      "trust_path": "runtime",
      "role": "Requirement, task lifecycle, status, recovery, Evidence, and Approval CLI.",
      "layer": "k1-runtime-kernel",
      "reason": "Covers ordinary durable task and status trust paths."
    }
  ],
